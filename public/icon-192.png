<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="192" height="192">
  <defs>
    <linearGradient id="matchaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#768B68" />
      <stop offset="50%" stop-color="#6B7F5E" />
      <stop offset="100%" stop-color="#5E7051" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F2D879" />
      <stop offset="50%" stop-color="#D4AF37" />
      <stop offset="100%" stop-color="#AA8820" />
    </linearGradient>
    <linearGradient id="stampGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D6583E" />
      <stop offset="100%" stop-color="#BA3F25" />
    </linearGradient>
  </defs>

  <rect width="512" height="512" rx="112" fill="url(#matchaGrad)" />
  <rect x="22" y="22" width="468" height="468" rx="94" fill="none" stroke="url(#goldGrad)" stroke-width="5" stroke-opacity="0.75" />
  <circle cx="256" cy="256" r="172" fill="none" stroke="url(#goldGrad)" stroke-width="4" stroke-opacity="0.55" stroke-dasharray="9 6" />

  <text x="256" y="342" font-family="'Noto Sans JP', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Meiryo', sans-serif" font-size="260" font-weight="900" text-anchor="middle" fill="#F9F6F0" letter-spacing="-0.02em">学</text>

  <g transform="translate(340, 340)">
    <rect width="82" height="82" rx="18" fill="url(#stampGrad)" stroke="#F2D1CA" stroke-width="2.5" stroke-opacity="0.85" />
    <text x="41" y="52" font-family="'Noto Sans JP', 'Plus Jakarta Sans', sans-serif" font-size="34" font-weight="900" text-anchor="middle" fill="#F9F6F0" letter-spacing="0.05em">N4</text>
  </g>
</svg>
